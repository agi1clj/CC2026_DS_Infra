# Copy to bootstrap.env (git-ignored) to pre-answer bootstrap.sh, or let bootstrap.sh create it.
# After renaming a GitHub repository, change the name here and re-run ./bootstrap/bootstrap.sh:
# the OIDC federated credential and the GitHub variables are updated to the new name.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
GITHUB_OWNER=your-github-user
APPS_REPO=CC2026_LastName_FirstName_Apps
INFRA_REPO=CC2026_LastName_FirstName_Infra
STUDENT_INITIALS=agi
AZURE_LOCATION=germanywestcentral

# Copy to terraform.tfvars (git-ignored). bootstrap/bootstrap.sh generates this file for you.
project_name     = "cc2026"
student_initials = "agi"
environment      = "dev"
location         = "germanywestcentral"
subscription_id  = "00000000-0000-0000-0000-000000000000" # your subscription: az account show --query id -o tsv

hosting         = "container_apps" # bootstrap.sh sets this for new setups; "app_service" needs B1 quota (then also app_service_sku = "B1")
acr_sku         = "Basic"

# create_web_apps defaults to true. Only the very first CI run uses false
# (GitHub variable CREATE_WEB_APPS); see README > Initial deployment.

# P2: Teams Workflows webhook URL (a secret, so this file stays git-ignored). Empty = no notifications.
# In GitHub Actions the same value comes from the secret TEAMS_WEBHOOK_URL.
# bootstrap.sh rewrites terraform.tfvars: add this line again after a re-run.
teams_webhook_url = ""
